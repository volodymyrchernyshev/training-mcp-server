@baseUrl = http://127.0.0.1:3000
@sessionId = 2759eb2a-7678-4217-a7d9-2bee1296de7f

### Health check
GET {{baseUrl}}/health


#### Initialize MCP session
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
"jsonrpc": "2.0",
"id": 1,
"method": "initialize",
"params": {
  "protocolVersion": "2025-06-18",
  "capabilities": {},
  "clientInfo": {
    "name": "intellij-http-client",
    "version": "1.0.0"
  }
}
}

### Acknowledge initialization
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{sessionId}}

{
"jsonrpc": "2.0",
"method": "notifications/initialized"
}

### List available tools
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{sessionId}}

{
"jsonrpc": "2.0",
"id": 2,
"method": "tools/list",
"params": {}
}

### Call the add tool
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{sessionId}}

{
"jsonrpc": "2.0",
"id": 3,
"method": "tools/call",
"params": {
  "name": "add",
  "arguments": {
    "a": 20,
    "b": 22
  }
}
}

### Read the static resource
POST {{baseUrl}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{sessionId}}

{
"jsonrpc": "2.0",
"id": 4,
"method": "resources/read",
"params": {
  "uri": "info://server"
}
}